;;; ═══════════════════════════════════════════════════════════════════════════════
;;; SSSP Driver — Host Program for Single-Source Shortest Path
;;; ═══════════════════════════════════════════════════════════════════════════════

;; Import the SSSP kernel
(require "sssp-kernel.cca")

;; Host-level program
(define-program "SSSP_Generated_CCASimulator"

  ;; Create the CCA simulator chip
  (create-simulator
    #:shape square
    #:dim-x (cli-arg "hx" #:type UInt32 #:default 3)
    #:dim-y (cli-arg "hy" #:type UInt32 #:default 5)
    #:memory-per-cc (cli-arg "m" #:type UInt32 #:default 524288)
    #:mesh-type (cli-arg "mesh" #:type UInt32 #:default 0)
    #:routing (cli-arg "route" #:type UInt32 #:default 0)
    #:htree-depth (cli-arg "hdepth" #:type UInt32 #:default 0)
    #:htree-bandwidth (cli-arg "hb" #:type UInt32 #:default 64))

  ;; Load weighted graph from file
  (load-graph
    #:file (cli-arg "f" #:type String #:required #t)
    #:name (cli-arg "g" #:type String #:required #t)
    #:vertex-type SSSPVertex
    #:weighted #t)

  ;; Register all actions with the simulator
  (register-actions sssp-action)

  ;; Germinate the root action to start relaxation
  (germinate sssp-action
    #:root (cli-arg "root" #:type UInt32 #:required #t)
    #:arguments (0)
    #:shuffle (cli-flag "shuffle"))

  ;; Run the simulation
  (run)

  ;; Verify results if requested
  (when (cli-flag "verify")
    (verify
      #:field distance
      #:extension ".sssp")))
