;;; ═══════════════════════════════════════════════════════════════════════════════
;;; SSSP Kernel — Single-Source Shortest Path Algorithm for CCA
;;; ═══════════════════════════════════════════════════════════════════════════════
;;;
;;; Pure computational kernel. Differs from BFS only in the propagation
;;; expression: adds edge weight instead of constant 1.
;;; ═══════════════════════════════════════════════════════════════════════════════

;; Sentinel value representing "not yet reached"
(define-constant max-distance : UInt32 999999)

;; The vertex data: one mutable field holding the current shortest distance
(define-vertex SSSPVertex
  [distance : UInt32 #:initial max-distance #:mutable])

;; The SSSP action: arrives at vertex v carrying an incoming-distance
(define-action sssp-action
  ([v : (Pointer SSSPVertex)]
   [incoming-distance : UInt32])
  (predicate (> (vertex-distance v) incoming-distance)
    (work
      (set-vertex-distance! v incoming-distance))
    (diffuse
      (predicate (= (vertex-distance v) incoming-distance))
      (for-each ([e : Edge] (vertex-edges v))
        (propagate sssp-action
                   (edge-address e)
                   (+ incoming-distance (edge-weight e)))))))
