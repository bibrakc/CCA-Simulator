;;; ═══════════════════════════════════════════════════════════════════════════════
;;; Single-Source Shortest Path (SSSP) on the CCA Architecture
;;; ═══════════════════════════════════════════════════════════════════════════════
;;;
;;; Computes shortest weighted distances from a root vertex to all reachable
;;; vertices. Identical structure to BFS except the propagation adds the edge
;;; weight instead of a constant 1.
;;;
;;; Algorithm:
;;;   1. All vertices start with distance = max-distance (unreachable)
;;;   2. Root receives distance 0 via the seed action
;;;   3. If a vertex receives a distance better than its current, it updates
;;;      and propagates (current_distance + edge_weight) to all neighbors
;;;   4. Repeated relaxation converges to correct shortest distances
;;;
;;; Key difference from BFS:
;;;   BFS:  propagate(level + 1)
;;;   SSSP: propagate(distance + edge-weight)
;;; ═══════════════════════════════════════════════════════════════════════════════

;; Sentinel value representing "not yet reached"
(define-constant max-distance : UInt32 999999)

;; The vertex data: one mutable field holding the current shortest distance
(define-vertex SSSPVertex
  [distance : UInt32 #:initial max-distance #:mutable])

;; The SSSP action: arrives at vertex v carrying an incoming-distance
(define-action sssp-action
  ([v : (Pointer SSSPVertex)]          ; target vertex (runtime-provided, not in payload)
   [incoming-distance : UInt32])       ; proposed distance (serialized in payload)

  (predicate (> (vertex-distance v) incoming-distance)
    ;; Only proceed if the incoming distance is shorter than what we have.

    (work
      ;; Store the better distance
      (set-vertex-distance! v incoming-distance))

    (diffuse
      (predicate (= (vertex-distance v) incoming-distance))
      ;; Only diffuse if this action won the race to set the distance.

      (for-each ([e : Edge] (vertex-edges v))
        ;; Send (current_distance + edge_weight) along each outgoing edge
        (propagate sssp-action
                   (edge-address e)
                   (+ incoming-distance (edge-weight e)))))))

(define-application SSSP
  #:binary-name "SSSP_Generated_CCASimulator"
  #:vertex-type SSSPVertex
  #:root-action sssp-action
  #:root-arguments (0)
  #:result-field distance
  #:verification ".sssp")
