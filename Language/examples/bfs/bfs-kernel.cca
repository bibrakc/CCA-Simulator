;;; ═══════════════════════════════════════════════════════════════════════════════
;;; BFS Kernel — Breadth-First Search Algorithm for CCA
;;; ═══════════════════════════════════════════════════════════════════════════════
;;;
;;; This file defines the pure computational kernel: vertex type, constants,
;;; and the action that implements BFS. It contains no host-level orchestration.
;;;
;;; To use: require this kernel from a driver program that sets up the
;;; simulator, loads a graph, and germinates the root action.
;;; ═══════════════════════════════════════════════════════════════════════════════

;; Sentinel value representing "not yet reached"
(define-constant max-level : UInt32 999999)

;; The vertex data: one mutable field holding the current BFS level
(define-vertex BFSVertex
  [level : UInt32 #:initial max-level #:mutable])

;; The BFS action: arrives at vertex v carrying an incoming-level
(define-action bfs-action
  ([v : (Pointer BFSVertex)]
   [incoming-level : UInt32])
  (predicate (> (vertex-level v) incoming-level)
    (work
      (set-vertex-level! v incoming-level))
    (diffuse
      (predicate (= (vertex-level v) incoming-level))
      (for-each ([e : Edge] (vertex-edges v))
        (propagate bfs-action
                   (edge-address e)
                   (+ incoming-level 1))))))
