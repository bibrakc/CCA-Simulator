;;; ═══════════════════════════════════════════════════════════════════════════════
;;; Breadth-First Search (BFS) on the CCA Architecture
;;; ═══════════════════════════════════════════════════════════════════════════════
;;;
;;; This program computes shortest hop distances from a root vertex to all
;;; reachable vertices in a graph. It is the canonical first example for the
;;; CCA language — the compiler generates C++ that runs on CCA-Simulator.
;;;
;;; Algorithm:
;;;   1. All vertices start with level = max-level (unreachable)
;;;   2. The root vertex receives level 0 via the seed action
;;;   3. If a vertex receives a level better than its current, it updates
;;;      and propagates level+1 to all neighbors
;;;   4. Repeated propagation converges to correct BFS levels
;;;
;;; The four action phases:
;;;   predicate       — accept only if incoming level is better (lower)
;;;   work            — store the new level
;;;   diffuse-pred   — confirm the level was actually written by this action
;;;                     (handles concurrent races: only the winner propagates)
;;;   diffuse         — send level+1 to each outgoing neighbor
;;; ═══════════════════════════════════════════════════════════════════════════════

;; Sentinel value representing "not yet reached" (must exceed any valid BFS depth)
(define-constant max-level : UInt32 999999)

;; The vertex data: one mutable field holding the current BFS level
(define-vertex BFSVertex
  [level : UInt32 #:initial max-level #:mutable])

;; The BFS action: arrives at vertex v carrying an incoming-level
(define-action bfs-action
  ([v : (Pointer BFSVertex)]        ; target vertex (provided by runtime, not in payload)
   [incoming-level : UInt32])       ; the proposed BFS level (serialized in payload)

  (predicate (> (vertex-level v) incoming-level)
    ;; Only proceed if the incoming level improves on what we have.
    ;; This prunes redundant/stale messages at the predicate stage.

    (work
      ;; Store the better level
      (set-vertex-level! v incoming-level))

    (diffuse
      (predicate (= (vertex-level v) incoming-level))
      ;; Only diffuse if WE are the action that set this level.
      ;; If a concurrent better action already overwrote it, suppress.

      (for-each ([e : Edge] (vertex-edges v))
        ;; Send level+1 along each outgoing edge
        (propagate bfs-action
                   (edge-address e)
                   (+ incoming-level 1))))))

;; Application metadata: tells the compiler how to generate the host program
(define-application BFS
  #:binary-name "BFS_Generated_CCASimulator"  ; name of the generated executable
  #:vertex-type BFSVertex                     ; which vertex struct to instantiate
  #:root-action bfs-action                    ; action to germinate at the root
  #:root-arguments (0)                        ; root gets level 0
  #:result-field level                        ; which field to verify against .bfs file
  #:verification ".bfs")                      ; verification file extension
